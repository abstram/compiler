# Abstram language - compiles to 32 bit bare metal assembly / C
# type system:
# every variable starts as starically typed
# if you cast a variable in a conditional branch and it's not reversed,
# that variable will be dynamically typed until it's cleared with --
# what that means is the compile inserts assembly to compare types at runtime
# if the type is considered dynamic
# two types, i and f, and the register types xi gi and xf
# gf doesn't exist, xf is the only register type for floats
# i and f are the funamental types while xi gi and xf are used when reserving registers
# in function declarations
# there are also several internal types in the compiler which represent the entire
# type system. these are ci and cf (constants), mi and mf (memory), gi (general), and xi and xf (xmm)
#
# random info: 
# if a number has a dot or ends in a dot its a float, otherwise int 
# the ^ symbol basically means, compiler come interpret this for me.
# it can be used for evaluating compile time math, doing type analysis, and
# most commonly replacing variable names in asm lines
# what happens if u run out of registers? use the $virtual feature which will manage
# register allocation. virtual registers go in and out of registers that aren't currently being used
# we have generic types kinda through type analysis, altho theres only really two types lol
# we have enums they're pretty normal
# arrays have to be handles by the user with memory regions, using registers or constants to determine location
# structs are similar but have nicer displacement syntax
# we also have unions 
# all of the structs and unions and enums and stuff arent considered types in the language, there are only
# feel free to write unoptimized code, it'll usually be raised to LLVM IR and optimized with whatever level you want

requires {
  include graphics # as gfx (if u wanna shorten it us "as"), grabs from standard library
  # the import keyword grabs the package from the online official language registry,
  # if its a local file you use import with quotes and the path
  link smgk # links this code agains the smgk core: the simple multi-threaded graphical kernel made by me too
  enable virtual # enable virtual types, remember virtual is discouraged
  # maybe ill remove virtual types entirely
}

# the memory[] array accesses all of the system's availiable ram so don't be afraid to use it
# its accessed in bytes so multiply it by size of type
# offsets in memory as integers act as pointers

enum color {
  RED
  GREEN
  BLUE
}

struct engine {
  mph: i
  hp: i
}

struct car {
  wheels: i
  seats: i
  color: i
  engine: i
}

union error {
  NONE,
  EXAMPLE_ERROR
}

struct result {
  error: i # union
  result: i # pointer to value in region
}


# all parameters are constant, bracket params are not, return reg also isn't
# if there's overlap in params and bracket params / ret reg, the original param is copied to memory
# fn pow (x: f/i, y:i) [i: gi/xi] -> result: ?
# fn pow [i: gi/xi] -> result: ?
# fn pow -> result: ?
# fn pow -> result: xi/xf
# fn pow -> result: xi
# fn pow {
fn pow! (x: f/i, y: i) [i: gi/xi] -> result: f/i {
  # ? means type unknown for now, must be resolved with type analysis like so

  # if you want more than LLVM O3 optimization, the ! after the name means it'll do windowed STOKE optimization
  # which will likely increase compile time by a lot but if you really want it, its available
  # if you want full perfect stoke optimization no matter what, not even windowed, you can do !! after the function name
  # the compiler will tell you if its having trouble optimizing a stoke function so if its super long you might have to
  # switch it to windowed anyways, or just use llvm o3 which is still really good

  result = x
  i = y

  while i > 1 {
    result *= x
    i -= 1
    i -= 1
  }
}

fn calculate_circle_area (radius: f) [i: gi/xi] -> result: xf {
  const PI = 3.1415 # compile time constant
  # if you use operations in compile-time constants, you need to use ^
  result = PI * pow (radius, 2) [i]
  # since pow returns a temp value, no need to put in register
  # math parser will handle temporary regsiter allocation throughout expressions
}

fn main {
  width :: eax = 300 # this is allowed
  height :: ebx
  height = 400

  graphics.rect (width, height)
  # alternatively, graphics.rect (300, 400) would work
  -- width, height # unbinds them from registers

  radius :: xmm0
  radius = 5.
  area :: xmm1 # currently has no type
  i :: eax
  i = 5

  area = calculate_circle_area (radius) [i] # inherits float type

  # area as i reinterprets
  # area to i converts it
  area to i

  memory [0] = area
  -- i

  if area < 500 && area > 0 {
    memory [area] = area
  }

  asm vshufps ^radius, ^radius, ^radius, 0b01010101
  # assembly code is treated like normal code, variable names are subbed in with ^name
  # you can also do asm {... multiple lines ...}

  -- * # clears everything (not memory obvi, but does clear memory bindings)

  area :: xmm0
  radius :: xmm1
  radius = 5.

  w :: virtual<gi>
  area = calculate_circle_area (radius) [w]
  # "virtual" is treated the same as a register here
  # and in the function when it was used it would be swapped in and out
  # multiple times if necessary and managed by the compiler itself

  # virtual is built into the language but it's meant to be the absolute last option
  # if you want though you could use virtual and basically turn the language into an 
  # automatically register managed one
  # e.g.
  -- *
  a :: virtual<gi>
  a = 7
  b :: virtual<gi>
  b = 9
  c :: virtual<xi>
  c = 15 + a + b
  # and so on and so forth without managing anything

  i :: esi
  i = 0

  # struct and enum usage
  engine of memory[i] = (
    .mph = 300
    .hp = 100
  )

  e :: edi
  e = i
  i += sizeof engine

  car of memory[i] = (
    .wheels = 4
    .seats = 2
    .color = color.RED
    .engine :: engine memory[e]
  )
  
  c :: eax
  c = i
  i += sizeof car

  result of memory[i] = (error.NONE, 5) # simpler way to init structs

  r1 :: ebx
  r1 = i
  i += sizeof result

  result of memory[i] = (.error = error.EXAMPLE_ERROR, .result = 0)
  
  r2 :: ecx
  r2 = i
  i += sizeof result
  
  car_c :: car memory[c] # if c changes car_c shifts
  # despite being on memory, by defining car you're assigning the memory values types
  w :: edx
  w = 5
  w += car_c.wheels
  w += car_c.engine.mph

  r1_o :: result memory[r1]
  if !r1_o.error {
    w += r1_o.result
  }

  r2_o :: result memory[r2]
  if !r2_o.error {
    w += r2_o.result
  }

  -- *
  x :: eax
  x = memory[50] # copies
  y :: ebx
  y = 5
  if x == 5 {
    y to f
  }
  
  z :: memory[50]
  z = 5
  # now x can be used like a variable
  # buuut you can't cast it into itself
  # like you can with registers
  # if the index is dynamic (has a runmtime var in it)
  # then it is tracked with that
  
  z to f :: memory[54]
  # alternatively, "z as f :: memory[54]"
  # just running z to f will have the compiler evaluate
  # the expresseison with z as the internal type of mi converting to mf
  # which is illegal and it'll error

  -- y
  y :: ebx
  y: i
}
